# OpenAI-compatible API key (required for the agent's LLM)
OPENAI_API_KEY=sk-...

# Model to use (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Spraay gateway URL (default: https://gateway.spraay.app)
# SPRAAY_GATEWAY_URL=https://gateway.spraay.app

# Guardrail overrides
# MAX_BATCH_USD=10000    # Maximum batch value in USD (stablecoins only)
# MAX_RECIPIENTS=200     # Maximum recipients per batch (gateway max: 200)
